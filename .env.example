# --- Provider selection ---
# Picks the AI provider for embeddings + generation. This is the one
# source of truth for the app's mode — nothing else overrides it.
#   mock   - deterministic local provider, in-memory corpus/chat store,
#            zero setup, no external services at all (default when unset).
#   ollama - real local embeddings + generation via Ollama, no API key,
#            no external network calls. Needs real Supabase (below).
#   openai - real OpenAI embeddings + generation. Needs real Supabase and
#            OPENAI_API_KEY (below).
DOCUMIND_AI_PROVIDER=mock

# --- Supabase ---
# Only needed for DOCUMIND_AI_PROVIDER=ollama or =openai. Project URL and
# anon key are safe for the browser; anon key is currently unused by the
# app (all data access is server-side) but kept for parity with a typical
# Supabase project setup. For local Supabase (`npx supabase start`), the
# URL is the plain API gateway root — e.g. http://127.0.0.1:54321 — not
# any of the other URLs `npx supabase status` prints (in particular, not
# the .../storage/v1/s3 endpoint).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, never imported into a "use client" module,
# never sent to the browser, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ollama (DOCUMIND_AI_PROVIDER=ollama) ---
# No API key — Ollama runs locally with no external calls. Defaults match
# a standard local `ollama serve`; override only if yours differs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
# Must produce 768-dimensional vectors to match
# supabase/migrations/0003_ollama_embedding_dimension.sql (vector(768)) —
# measured directly against a live embed request, not assumed from
# documentation. Switching embedding models to a different dimension
# needs a matching migration and a full re-ingest; see README "Vector
# dimension".
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Only for the public demo, where Ollama sits behind an ngrok tunnel that
# requires a bearer token (see README "Public demo"). Leave empty for a
# plain local `ollama serve`.
OLLAMA_AUTH_TOKEN=

# --- OpenAI (DOCUMIND_AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Must produce 1536-dimensional vectors — this is a DIFFERENT dimension
# than the Ollama migration above targets. Switching to DOCUMIND_AI_PROVIDER=openai
# against a database migrated for Ollama will fail with a clear
# configuration error (see lib/rag/retrieval.ts) rather than a cryptic
# Postgres one; you'd need the 1536-dim schema from
# supabase/migrations/0001_init.sql instead, and a full re-ingest.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG tuning ---
# Cosine similarity floor a chunk must clear to be considered relevant.
# Leave unset to use the provider-aware measured default (mock 0.22 /
# ollama 0.6 / openai 0.72 — see src/lib/config.ts for how each was
# chosen, and README "pgvector retrieval" for the Ollama threshold sweep).
RAG_MATCH_THRESHOLD=
# Max chunks retrieval returns.
RAG_MATCH_COUNT=6
# Hard cap on characters sent to the model as context.
RAG_CONTEXT_MAX_CHARS=12000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
