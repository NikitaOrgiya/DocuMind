# --- Supabase ---
# Project URL and anon key are safe for the browser; anon key is currently
# unused by the app (all data access is server-side) but kept for parity
# with a typical Supabase project setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only, never imported into a "use client" module,
# never sent to the browser, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Must produce 1536-dimensional vectors to match supabase/migrations/0001_init.sql
# (vector(1536)). If you switch embedding models to a different dimension,
# update the migration's `vector(N)` and re-run ingestion from scratch.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG tuning ---
# Cosine similarity floor a chunk must clear to be considered relevant.
# Leave unset to use the mode-aware default (0.72 real / 0.12 mock — see
# src/lib/config.ts for why the mock default is so much lower).
RAG_MATCH_THRESHOLD=
# Max chunks retrieval returns.
RAG_MATCH_COUNT=6
# Hard cap on characters sent to the model as context.
RAG_CONTEXT_MAX_CHARS=12000

# --- Local demo mode ---
# Force the deterministic mock AI provider + in-memory corpus/chat store even
# if OPENAI_API_KEY/Supabase vars above are set. Automatically on whenever
# either is missing — see README "Local demo mode".
DOCUMIND_MOCK_AI=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
